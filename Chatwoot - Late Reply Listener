    {
      "parameters": {
        "jsCode": "const b = $json.body ?? $json;\nif (b.event !== 'message_created' || b.private === true) return [];\n\nconst conv = b.conversation ?? {};\nconst assignee = conv.meta?.assignee ?? conv.assignee ?? {};\nconst mt = String(b.message_type ?? '').toLowerCase();\nconst conversation_id = String(conv.id ?? b.conversation_id ?? '');\nif (!conversation_id) return [];\n\nconst toIso = (v) => {\n  if (v === null || v === undefined || v === '') return new Date().toISOString();\n  if (typeof v === 'number') return new Date(v < 1e12 ? v * 1000 : v).toISOString();\n  const n = Number(v);\n  if (!Number.isNaN(n) && String(v).trim() !== '') return new Date(n < 1e12 ? n * 1000 : n).toISOString();\n  const d = new Date(v);\n  return Number.isNaN(d.getTime()) ? new Date().toISOString() : d.toISOString();\n};\n\nif (mt === 'incoming' || mt === '0') {\n  const now = new Date().toISOString();\n  const state = {\n    display_id: String(conv.display_id ?? conv.id ?? ''),\n    account_id: String(b.account?.id ?? conv.account_id ?? ''),\n    inbox_id: String(conv.inbox_id ?? conv.inbox?.id ?? ''),\n    customer_message_at: toIso(b.created_at),\n    monitored_agent_id: String(assignee.id ?? ''),\n    monitored_agent_name: String(assignee.name ?? ''),\n    stage: 'WAITING_WARNING',\n    stage_started_at: now,\n    handoff_count: 0\n  };\n  return [{ json: { action: 'start', conversation_id, active: true, state: JSON.stringify(state) } }];\n}\n\nif (mt === 'outgoing' || mt === '1') {\n  const senderType = String(b.sender?.type ?? b.sender_type ?? '').toLowerCase();\n  if (senderType !== 'user') return [];\n  return [{ json: { action: 'stop', conversation_id, active: false } }];\n}\n\nreturn [];"
