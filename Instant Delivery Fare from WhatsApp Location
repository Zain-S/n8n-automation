    {
      "parameters": {
        "jsCode": "const input = $json;\nconst originalQuery = String(input.geocode_query || '').trim();\n\nif (!originalQuery) {\n  throw new Error('No address received.');\n}\n\nconst withoutPostal = originalQuery\n  .replace(/,?\\s*\\d{5,6}\\s*$/, '')\n  .trim();\n\nconst parts = withoutPostal\n  .split(',')\n  .map(x => x.trim())\n  .filter(Boolean);\n\nconst queries = [];\n\n// Full address\nqueries.push(withoutPostal);\n\n// Without first place/business name\nif (parts.length > 2) {\n  queries.push(parts.slice(1).join(', '));\n}\n\n// Remove first two parts\nif (parts.length > 3) {\n  queries.push(parts.slice(2).join(', '));\n}\n\n// Last 3 address parts\nif (parts.length >= 3) {\n  queries.push(parts.slice(-3).join(', '));\n}\n\n// Last 2 address parts\nif (parts.length >= 2) {\n  queries.push(parts.slice(-2).join(', '));\n}\n\nconst uniqueQueries = [...new Set(queries)];\n\n\n// ======================================\n// 1. TRY NOMINATIM\n// ======================================\n\nfor (const query of uniqueQueries) {\n  try {\n    const result = await this.helpers.httpRequest({\n      method: 'GET',\n      url: 'https://nominatim.openstreetmap.org/search',\n      qs: {\n        q: query + ', Pakistan',\n        format: 'jsonv2',\n        limit: 1,\n        countrycodes: 'pk',\n\n        // Bias search around Lahore\n        viewbox: '74.15,31.65,74.50,31.35',\n        bounded: 0\n      },\n      headers: {\n        'User-Agent': 'KKFoods-delivery-estimator/1.0'\n      },\n      json: true\n    });\n\n    if (Array.isArray(result) && result.length > 0) {\n\n      const latitude = Number(result[0].lat);\n      const longitude = Number(result[0].lon);\n\n      if (\n        Number.isFinite(latitude) &&\n        Number.isFinite(longitude)\n      ) {\n        return [{\n          json: {\n            latitude,\n            longitude,\n            conversation_id: input.conversation_id,\n            account_id: input.account_id,\n            geocoder: 'nominatim',\n            matched_address: result[0].display_name,\n            geocode_query_used: query\n          }\n        }];\n      }\n    }\n\n  } catch (e) {}\n}\n\n\n// ======================================\n// 2. TRY PHOTON\n// ======================================\n\nfor (const query of uniqueQueries) {\n  try {\n\n    const result = await this.helpers.httpRequest({\n      method: 'GET',\n      url: 'https://photon.komoot.io/api/',\n      qs: {\n        q: query + ', Lahore, Pakistan',\n        limit: 1,\n\n        // Bias results around Lahore\n        lat: 31.5204,\n        lon: 74.3587\n      },\n      headers: {\n        'User-Agent': 'KKFoods-delivery-estimator/1.0'\n      },\n      json: true\n    });\n\n    const feature = result?.features?.[0];\n\n    if (\n      feature &&\n      Array.isArray(feature.geometry?.coordinates)\n    ) {\n\n      // Photon = longitude, latitude\n      const longitude =\n        Number(feature.geometry.coordinates[0]);\n\n      const latitude =\n        Number(feature.geometry.coordinates[1]);\n\n      if (\n        Number.isFinite(latitude) &&\n        Number.isFinite(longitude)\n      ) {\n\n        return [{\n          json: {\n            latitude,\n            longitude,\n            conversation_id: input.conversation_id,\n            account_id: input.account_id,\n            geocoder: 'photon',\n            matched_address:\n              feature.properties?.name || query,\n            geocode_query_used: query\n          }\n        }];\n      }\n    }\n\n  } catch (e) {}\n}\n\n\n// ======================================\n// NOTHING FOUND\n// ======================================\n\nthrow new Error(\n  `Could not find coordinates for: ${originalQuery}`\n);"
      },
