    {
      "parameters": {
        "jsCode": "const body = $json.body;\n\n// Ignore anything that is not an incoming customer message\nif (\n  !body ||\n  body.event !== 'message_created' ||\n  body.message_type !== 'incoming' ||\n  body.private === true\n) {\n  return [];\n}\n\nconst content = String(body.content || '');\n\nconst googleMapsMatch = content.match(\n  /(https?:\\/\\/(?:maps\\.app\\.goo\\.gl|goo\\.gl\\/maps|www\\.google\\.com\\/maps)[^\\s]+)/\n);\n\nif (googleMapsMatch) {\n  return [\n    {\n      json: {\n        google_maps_url: googleMapsMatch[1],\n        conversation_id: body.conversation.id,\n        account_id: body.account.id,\n        location_type: 'google_maps_link'\n      }\n    }\n  ];\n}\n\n// Only continue if this is an actual WhatsApp location message\nconst latMatch = content.match(/\\*Latitude:\\*\\s*([-\\d.]+)/);\nconst lonMatch = content.match(/\\*Longitude:\\*\\s*([-\\d.]+)/);\n\nif (!latMatch || !lonMatch) {\n  return [];\n}\n\nconst latitude = Number(latMatch[1]);\nconst longitude = Number(lonMatch[1]);\n\nif (!Number.isFinite(latitude) || !Number.isFinite(longitude)) {\n  return [];\n}\n\nreturn [\n  {\n    json: {\n      latitude,\n      longitude,\n      conversation_id: body.conversation.id,\n      account_id: body.account.id\n    }\n  }\n];"
