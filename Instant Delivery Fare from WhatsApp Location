        "jsCode": "const input = $input.first().json;\n\n// Chatwoot settings\nconst CHATWOOT_BASE_URL = 'https://chatwoot.distributorflow.com';\nconst CHATWOOT_ACCOUNT_ID = input.account_id;\n\n// Delivery settings\nconst ORIGIN_LAT = 31.581515;\nconst ORIGIN_LON = 74.377472;\nconst BASE_FARE = 100;\nconst RATE_PER_KM = 15.5;\nconst FREE_DELIVERY = 150;\n\nreturn [\n  {\n    json: {\n      latitude: input.latitude,\n      longitude: input.longitude,\n      conversation_id: input.conversation_id,\n      account_id: CHATWOOT_ACCOUNT_ID,\n\n      originLat: ORIGIN_LAT,\n      originLon: ORIGIN_LON,\n\n      baseFare: BASE_FARE,\n      ratePerKm: RATE_PER_KM,\n      freeDelivery: FREE_DELIVERY,\n\n      chatwootBaseUrl: CHATWOOT_BASE_URL\n    }\n  }\n];"
