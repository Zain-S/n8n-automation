    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const cfg = $('Normalize Location + Config').first().json;\nconst response = $json;\n\nif (\n  response.code !== 'Ok' ||\n  !Array.isArray(response.routes) ||\n  !response.routes.length\n) {\n  throw new Error(\n    `OSRM could not calculate a route. Code: ${response.code ?? 'unknown'}`\n  );\n}\n\nconst meters = Number(response.routes[0].distance);\n\nif (!Number.isFinite(meters)) {\n  throw new Error('OSRM route did not contain a valid distance.');\n}\n\nconst distanceKm = meters / 1000;\n\n// Courier fare calculation\nconst estimatedFare = Math.round(\n  cfg.baseFare + (cfg.ratePerKm * distanceKm)\n);\n\n// Remove free delivery benefit\nlet remainingFare = Math.max(\n  0,\n  estimatedFare - cfg.freeDelivery\n);\n\n// Minimum instant delivery charge Rs.100\nif (remainingFare > 0 && remainingFare < 100) {\n  remainingFare = 100;\n}\n\n// Delivery eligibility\nlet eligibility;\n\nif (distanceKm <= 25) {\n  eligibility = '✅ All pack sizes can be delivered.';\n} else if (distanceKm <= 30) {\n  eligibility = '⚠️ Only 10L can be delivered.';\n} else {\n  eligibility = '⛔ Instant delivery is not available at this distance.';\n}\n\n\n// Agent private note\nconst note = [\n  remainingFare > 0\n    ? `⚡ Instant Delivery Charges: Rs.${remainingFare}`\n    : `✅ Instant Delivery: FREE`,\n\n  `📍 Distance: ${distanceKm.toFixed(2)} KM`,\n\n  '',\n\n  '💳 Payment Instructions:',\n  'Customer has to pay the complete amount in advance through online payment. Delivery will be dispatched via inDrive Courier.',\n\n  '',\n\n  'JazzCash:',\n  '03221843090',\n  'Zain',\n\n  '',\n\n  \"If customer doesn't want to make advance online payment, please contact admin.\",\n\n  '',\n\n  eligibility\n].join('\\n');\n\n\nreturn {\n  json: {\n    ...cfg,\n    deliveryService: 'inDrive Courier',\n    distanceMeters: meters,\n    distanceKm: Math.round(distanceKm * 100) / 100,\n    estimatedFare,\n    remainingFare,\n    eligibility,\n    note\n  }\n};"
      },
