    {
      "parameters": {
        "jsCode": "const original = $('Extract Location').first().json;\n\nconst html = String(\n  $json.data ??\n  $json.body ??\n  ''\n);\n\nlet query = null;\n\n// Extract q=Shadab+Colony+Rd%2C+Lahore\nconst qMatch = html.match(/[?&](?:amp;)?q=([^&\"']+)/i);\n\nif (qMatch) {\n  try {\n    query = decodeURIComponent(\n      qMatch[1].replace(/\\+/g, ' ')\n    );\n  } catch {\n    query = qMatch[1].replace(/\\+/g, ' ');\n  }\n}\n\nif (!query) {\n  throw new Error('Could not extract location name from Google Maps link.');\n}\n\nreturn [{\n  json: {\n    geocode_query: query,\n    conversation_id: original.conversation_id,\n    account_id: original.account_id\n  }\n}];"
