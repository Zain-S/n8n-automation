    {
      "parameters": {
        "jsCode": "const input = $json;\nconst text = String(input.geocode_query).trim();\n\nlet latitude;\nlet longitude;\n\n// Decimal format: 31.493813,74.313731\nconst decimalMatch = text.match(\n  /^(-?\\d+(?:\\.\\d+)?)\\s*,\\s*(-?\\d+(?:\\.\\d+)?)$/\n);\n\nif (decimalMatch) {\n  latitude = Number(decimalMatch[1]);\n  longitude = Number(decimalMatch[2]);\n} else {\n  // DMS format\n  const dmsMatch = text.match(\n    /(\\d+)°(\\d+)'([\\d.]+)\"([NS])\\s+(\\d+)°(\\d+)'([\\d.]+)\"([EW])/\n  );\n\n  if (!dmsMatch) {\n    throw new Error('Could not convert Google Maps coordinates.');\n  }\n\n  function dmsToDecimal(deg, min, sec, dir) {\n    let decimal =\n      Number(deg) +\n      Number(min) / 60 +\n      Number(sec) / 3600;\n\n    if (dir === 'S' || dir === 'W') decimal *= -1;\n\n    return decimal;\n  }\n\n  latitude = dmsToDecimal(\n    dmsMatch[1],\n    dmsMatch[2],\n    dmsMatch[3],\n    dmsMatch[4]\n  );\n\n  longitude = dmsToDecimal(\n    dmsMatch[5],\n    dmsMatch[6],\n    dmsMatch[7],\n    dmsMatch[8]\n  );\n}\n\nreturn [{\n  json: {\n    latitude,\n    longitude,\n    conversation_id: input.conversation_id,\n    account_id: input.account_id\n  }\n}];"
      },
