      "id": "25d17a0d-c409-406d-bd97-00ec71261c16",
      "name": "Get file's Diffs from PR",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        432,
        1136
      ],
      "typeVersion": 4.2,
      "credentials": {
        "githubApi": {
          "id": "SEYz6E5AQBY7Meoc",
          "name": "GitHub account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const files = $input.all().map(item => item.json);\n\nlet diffs = '';\n\nfor (const file of files) {\n  diffs += `### Fichier : ${file.filename}\\n\\n`;\n\n  if (file.patch) {\n    // IMPORTANT : On remplace tous les triple backticks par simple (ou échappement)\n    const safePatch = file.patch.replace(/```/g, \"''\");\n\n    diffs += \"```diff\\n\";\n    diffs += safePatch;\n    diffs += \"\\n```\\n\";\n  } else {\n    diffs += \"_Pas de patch disponible (probablement fichier binaire)._\";\n  }\n\n  diffs += \"\\n---\\n\\n\";\n}\n\nconst userMessage = `\nYou are a senior developer.\nPlease review the following code changes in these files and give short review only for important issues:\n${diffs}\n---\nFollow:\n- Google style guide for coding: https://google.github.io/styleguide/\n- Owasp complience for Security bugs\n- Check page speed if its web page\n---\nYour mission:\nPriorities (in order):\n1. Security bugs\n2. Memory leaks\n3. CPU leaks\n4. Redundant logic\n5. Architecture/design pattern improvements\n\nUse medium-level code quality and standard code suggestions.\n\nFor each comment, include a severity tag:\n🔴 HIGH – Critical issue or potential bug\n🟡 MEDIUM – Needs improvement or optimization\n🔵 LOW – Minor or stylistic suggestion\n\nKeep comments concise (1 to 3 lines per issue, no intros, no summaries).\nIssue Format should be: \n1. Severity: xxx \n2. Issue : xxx\n3. Suggestion: xxx\n`;\n\nreturn [\n  {\n    json: {\n      user_message: userMessage.trim()\n    }\n  }\n];"
      },
