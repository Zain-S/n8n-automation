    {
      "parameters": {
        "jsCode": "const error = $('Commit Message Breakdown').first().json.error\n\n// === Input data ===\nconst users = $(\"Get Users\").all(); // from Google Sheets node\n\n// === Helper: Find user safely ===\nfunction findGithub(username) {\n  return users.find(u => u.json.Github_UserName?.toLowerCase() === username.toLowerCase());\n}\n\n// Get the user info from GitHub username, assuming you have Slack user ID available as well\nconst submitted_user = findGithub($('Add Label to PR').first().json.user.login);\nconst slack_user_id = submitted_user?.json?.Slack_User_id || '';  // Assuming Slack User ID is available in the data\n\nconst ai_review = $('Code Review Agent').first().json.output;\nconst pr_title = $('Repo Setting').first().json.pr_title;\nconst pr_description = $('Repo Setting').first().json.pr_description || \"\";\nconst pr_link = $('PR Events Webhook').first().json.body.pull_request.html_url;\n\nconst message = `*🚀 New PR Submitted - Reviewed by AI*\\n🔹 *Submitted by*: <@${slack_user_id}> \\n *📜 PR Title*: *<${pr_link}|${pr_title}>*\\n *📝 PR Description*: ${pr_description || 'No description provided'}\\n\\n *🤖 AI Review*:\\n${ai_review}\\n *🔗 PR Link*: *<${pr_link}|View PR on GitHub>*`\n\nlet finalMessage = ''\nif (error) {\n  finalMessage = error + '\\n' + message\n} else {\n  finalMessage = message\n}\n\n// === Final merged report ===\nconst finalReport = {\n  text: finalMessage\n}\n\nreturn finalReport;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2560,
        464
      ],
      "id": "f3b73210-ef66-4bff-abb7-30634c977b34",
      "name": "Format Data for Slack"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const prTitle = $('Repo Setting').first().json.pr_title;\nconst prLink = $('Repo Setting').first().json.pr_link;\nconst prDescription = $('Repo Setting').first().json.pr_description;\nconst slackUserId = $json.submitted_user.Slack_User_id;\n\n// Updated regex to make the [...] part optional\nconst regex = /^([A-Z]+-\\d+)\\s(.*?)(?:\\s\\[(.*)\\])?$/;\nconst match = prTitle.match(regex);\nlet error;\nif (!match) {\n  error = `*:x: Incorrect Format*\\n *:warning: Error*: Commit message format is incorrect. Missing task key or message. Correct Format is: [PROJECT_KEY-ISSUE_NUMBER] Commit description`;\n  return {\n    error\n  };\n}\n\nconst jiraKey = match[1];\nconst commitDescription = match[2].trim();\nconst flagString = match[3];\nconst flags = flagString ? flagString.split(',').map(s => s.trim()) : [];\n\nreturn {\n  json: {\n    jiraKey,\n    commitDescription,\n    commands: flags,\n  }\n};\n"
      },
