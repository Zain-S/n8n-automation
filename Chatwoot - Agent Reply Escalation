    {
      "parameters": {
        "jsCode": "const r = $('Decide State').item.json;\n\nconst agentName = r.monitored_agent_name || 'Unassigned';\nconst customerName = r.customer_name || 'Unknown';\nconst conversationUrl = r.conversation_url || '';\nconst lastMessage = r.last_customer_message || 'No customer message found';\n\nconst baseInfo =\n  'Customer: ' + customerName + '\\n' +\n  'Conversation: ' + conversationUrl + '\\n\\n' +\n  'Last Customer Message:\\n' +\n  lastMessage;\n\n\n// Agent warning\nconst agentWarningMessage =\n  '⚠️ Late Reply Warning\\n\\n' +\n  'Agent: ' + agentName + '\\n' +\n  baseInfo +\n  '\\n\\n' +\n  'You have not replied for 10 minutes. Please reply now.';\n\n\n// Admin warning\nconst adminWarningMessage =\n  '🚨 Admin Alert - Late Reply\\n\\n' +\n  'Agent: ' + agentName + '\\n' +\n  baseInfo +\n  '\\n\\n' +\n  'Agent has not replied for 10 minutes.';\n\n\n// Agent reassignment\nconst newAgent =\n  r.next_agent_name || 'Unknown';\n\nconst reassignmentMessage =\n  '🔁 Chat Reassigned\\n\\n' +\n  baseInfo +\n  '\\n\\n' +\n  'From: ' + agentName + '\\n' +\n  'To: ' + newAgent +\n  '\\n\\n' +\n  'The new agent now has 5 minutes to reply before receiving a warning.';\n\n\n// Admin reassignment\nconst adminReassignmentMessage =\n  '🚨 Admin Alert - Chat Reassigned\\n\\n' +\n  baseInfo +\n  '\\n\\n' +\n  'From: ' + agentName + '\\n' +\n  'To: ' + newAgent;\n\n\n// No active agent\nconst noAgentMessage =\n  '🚨 No Active Agent Available\\n\\n' +\n  baseInfo +\n  '\\n\\n' +\n  'Current Agent: ' + agentName +\n  '\\n\\n' +\n  'The customer is still waiting, but there is currently no other online agent available for reassignment.';\n\n\nreturn {\n  json: {\n    ...r,\n\n    agentWarningMessage,\n    adminWarningMessage,\n    reassignmentMessage,\n    adminReassignmentMessage,\n    noAgentMessage\n  }\n};"
      },
