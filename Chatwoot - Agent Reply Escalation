    {
      "parameters": {
        "jsCode": "const row = $('Loop Over Due').item.json;\nconst live = $json ?? {};\n\nconst toMs = (v) => {\n  if (v === null || v === undefined || v === '') return 0;\n\n  if (typeof v === 'number') {\n    return v < 1e12 ? v * 1000 : v;\n  }\n\n  const n = Number(v);\n\n  if (!Number.isNaN(n) && String(v).trim() !== '') {\n    return n < 1e12 ? n * 1000 : n;\n  }\n\n  const t = Date.parse(v);\n\n  return Number.isNaN(t) ? 0 : t;\n};\n\n\n// -----------------------------\n// Conversation status\n// -----------------------------\n\nconst status = String(\n  live.status ?? ''\n).toLowerCase();\n\n\n// -----------------------------\n// Current assigned agent\n// -----------------------------\n\nconst assignee =\n  live.meta?.assignee ??\n  live.assignee ??\n  {};\n\nconst current_agent_id = String(\n  assignee.id ?? ''\n);\n\nconst current_agent_name = String(\n  assignee.name ??\n  assignee.available_name ??\n  ''\n);\n\nconst current_agent_role = String(\n  assignee.role ?? ''\n).toLowerCase();\n\n\n// -----------------------------\n// Customer details\n// -----------------------------\n\nconst customer_name =\n  live.meta?.sender?.name ||\n  live.sender?.name ||\n  'Unknown';\n\n\n// -----------------------------\n// Messages\n// -----------------------------\n\nconst messages =\n  Array.isArray(live.messages)\n    ? live.messages\n    : Array.isArray(live.payload?.messages)\n      ? live.payload.messages\n      : [];\n\n\n// -----------------------------\n// Last customer message\n// -----------------------------\n\nconst last_customer_message = messages\n  .filter(m =>\n    String(m.message_type).toLowerCase() === 'incoming'\n  )\n  .sort((a, b) =>\n    toMs(b.created_at) - toMs(a.created_at)\n  )[0]?.content || 'No customer message found';\n\n\n// -----------------------------\n// Conversation URL\n// -----------------------------\n\nconst conversation_url =\n  `${$('Loop Over Due').item.json.chatwoot_url || 'https://chatwoot.distributorflow.com'}/app/accounts/${row.account_id}/conversations/${row.conversation_id}`;\n\n\n// -----------------------------\n// Customer replied?\n// -----------------------------\n\nconst customerTs = toMs(\n  row.customer_message_at\n);\n\nconst replied = messages.some((m) => {\n\n  const mt = String(\n    m.message_type ?? ''\n  ).toLowerCase();\n\n  const outgoing =\n    mt === 'outgoing' ||\n    mt === '1';\n\n  if (!outgoing) {\n    return false;\n  }\n\n  if (m.private === true) {\n    return false;\n  }\n\n  const senderType = String(\n    m.sender?.type ??\n    m.sender_type ??\n    ''\n  ).toLowerCase();\n\n  if (senderType !== 'user') {\n    return false;\n  }\n\n  return toMs(m.created_at) >= customerTs;\n});\n\n\n// -----------------------------\n// Decide action\n// -----------------------------\n\nlet decision = 'reset';\nlet stop_stage = '';\n\nif (replied) {\n\n  decision = 'stop';\n  stop_stage = 'REPLIED';\n\n} else if (\n  status === 'resolved' ||\n  status === 'closed'\n) {\n\n  decision = 'stop';\n  stop_stage = 'RESOLVED';\n\n} else if (\n  current_agent_role === 'administrator'\n) {\n\n  decision = 'stop';\n  stop_stage = 'ADMIN_IGNORED';\n\n} else if (!current_agent_id) {\n\n  decision = 'reassign';\n\n} else if (\n  String(row.monitored_agent_id ?? '') !==\n  current_agent_id\n) {\n\n  decision = 'reset';\n\n} else if (\n  row.stage === 'WAITING_WARNING'\n) {\n\n  decision = 'warn';\n\n} else if (\n  row.stage === 'WAITING_REASSIGN'\n) {\n\n  decision = 'reassign';\n}\n\n\n// -----------------------------\n// Output\n// -----------------------------\n\nreturn [{\n  json: {\n    ...row,\n\n    current_agent_id,\n    current_agent_name,\n    current_agent_role,\n\n    customer_name,\n    last_customer_message,\n    conversation_url,\n\n    decision,\n    stop_stage\n  }\n}];"
      },
