    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const row = $json;\nconst now = Date.now();\n\nlet state = {};\n\ntry {\n  state = typeof row.state === 'string'\n    ? JSON.parse(row.state)\n    : (row.state || {});\n} catch (e) {\n  state = {};\n}\n\nconst stageStartedAt = state.stage_started_at\n  ? new Date(state.stage_started_at).getTime()\n  : 0;\n\nconst elapsedMs = stageStartedAt\n  ? now - stageStartedAt\n  : 0;\n\nconst TEN_MINUTES = 10 * 60 * 1000;\nconst FIVE_MINUTES = 5 * 60 * 1000;\n\nlet due = false;\n\n// First warning after 10 minutes\nif (state.stage === 'WAITING_WARNING') {\n  due = elapsedMs >= TEN_MINUTES;\n}\n\n// Reassign 5 minutes after warning\nif (state.stage === 'WAITING_REASSIGN') {\n  due = elapsedMs >= FIVE_MINUTES;\n}\n\nreturn {\n  json: {\n    conversation_id: String(row.conversation_id),\n    active: row.active,\n    ...state,\n    due,\n    elapsed_minutes: Math.floor(elapsedMs / 60000)\n  }\n};"
