    {
      "parameters": {
        "jsCode": "const r = $('Decide State').item.json;\n\n// -------------------------\n// Get inbox agents\n// -------------------------\nconst inboxResult = $('Get Inbox Agents').item.json;\n\nconst inboxAgents = Array.isArray(inboxResult.payload)\n  ? inboxResult.payload\n  : Array.isArray(inboxResult)\n    ? inboxResult\n    : [];\n\n// -------------------------\n// Get account agents\n// Get Account Agents returns\n// one n8n item per agent\n// -------------------------\nconst accountAgents = $input.all().map(item => item.json);\n\n// Current assigned agent\nconst currentAgentId = String(\n  r.current_agent_id ||\n  r.monitored_agent_id ||\n  ''\n);\n\n// IDs of agents that belong to this inbox\nconst inboxAgentIds = new Set(\n  inboxAgents.map(agent => String(agent.id))\n);\n\n// Find agents who:\n// 1. belong to this inbox\n// 2. are online\n// 3. are confirmed\n// 4. are NOT current agent\nconst eligibleAgents = accountAgents\n  .filter(agent =>\n    inboxAgentIds.has(String(agent.id))\n  )\n  .filter(agent =>\n    String(agent.availability_status || '').toLowerCase() === 'online'\n  )\n  .filter(agent =>\n    agent.confirmed === true\n  )\n  .filter(agent =>\n    String(\n      agent.role || ''\n    ).toLowerCase() !== 'administrator'\n  )\n  .filter(agent =>\n    String(agent.id) !== currentAgentId\n  )\n  .sort((a, b) => Number(a.id) - Number(b.id));\n\nif (eligibleAgents.length === 0) {\n  return [{\n    json: {\n      ...r,\n      no_agent_available: true,\n      next_agent_id: null,\n      next_agent_name: null\n    }\n  }];\n}\n\n// Find next ID after current agent\nlet nextAgent = eligibleAgents.find(\n  agent => Number(agent.id) > Number(currentAgentId)\n);\n\n// If none is greater, wrap around\nif (!nextAgent) {\n  nextAgent = eligibleAgents[0];\n}\n\nreturn [{\n  json: {\n    ...r,\n    no_agent_available: false,\n    next_agent_id: String(nextAgent.id),\n    next_agent_name:\n      nextAgent.name ||\n      nextAgent.available_name ||\n      nextAgent.email\n  }\n}];"
