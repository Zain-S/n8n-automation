      "parameters": {
        "jsCode": "const body = $json.body ?? $json;\n\nif (body.event !== 'message_created') {\n  return [];\n}\n\nif (body.message_type !== 'outgoing') {\n  return [];\n}\n\nconst content = String(body.content || '');\n\nif (!content.includes('Your Order Confirmation')) {\n  return [];\n}\n\nconst lowerContent = content.toLowerCase();\n\nlet adTitle = null;\n\nconst hasGreatSuper = lowerContent.includes('great super');\nconst hasHappyTime = lowerContent.includes('happy time');\nconst hasZaiqa = lowerContent.includes('zaiqa ice cream');\n\nconst matchedBrands = [\n  hasGreatSuper,\n  hasHappyTime,\n  hasZaiqa\n].filter(Boolean).length;\n\n// Must match exactly one brand\nif (matchedBrands !== 1) {\n  return [];\n}\n\nif (hasGreatSuper) {\n  adTitle = 'Great Super';\n} else if (hasHappyTime) {\n  adTitle = 'Happy Time';\n} else if (hasZaiqa) {\n  adTitle = 'Zaiqa Ice Cream';\n}\n\nconst amountMatch = content.match(\n  /Total Amount:\\*?\\*?\\s*Rs\\.?\\s*([0-9,]+)/i\n);\n\nif (!amountMatch) {\n  return [];\n}\n\nconst amount = Number(\n  amountMatch[1].replace(/,/g, '')\n);\n\nconst phone =\n  body.conversation?.meta?.sender?.phone_number\n  ?.replace('+', '');\n\nif (!phone) {\n  return [];\n}\n\nreturn [\n  {\n    json: {\n      phone,\n      amount,\n      currency: 'PKR',\n      adTitle,\n      conversationId: body.conversation.id,\n      messageId: body.id,\n      content\n    }\n  }\n];"
      },
